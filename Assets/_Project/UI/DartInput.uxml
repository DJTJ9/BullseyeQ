                                    <ui:ScrollView name="co-td-rounds-scroll" class="scroll">
                                        <ui:VisualElement name="co-td-rounds-container">
                                            <ui:VisualElement class="list-row">
                                                <ui:Label name="darts" text="D20  S20  D20" class="list-row__darts"/>
                                                <ui:Label name="hits" text="Hits 2" class="list-row__rem"/>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:ScrollView>
                                    <ui:VisualElement class="button-row">
                                        <ui:Button name="co-td-btn-new" text="New session" class="text-button text-button--primary button-row__gap"/>
                                        <ui:Button name="co-td-btn-reset" text="Reset session" class="text-button text-button--danger"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-side panel panel--grow">
                                <ui:Label text="Session stats" class="section-title"/>
                                <ui:VisualElement class="stat-grid">
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-td-stat-hitrate" text="–" class="stat-value"/>
                                        <ui:Label text="Hit rate" class="stat-caption"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-td-stat-hits" text="–" class="stat-value"/>
                                        <ui:Label text="Hits" class="stat-caption"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-td-stat-attempts" text="–" class="stat-value"/>
                                        <ui:Label text="Attempts" class="stat-caption"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="co-td-heatmap-container" class="heatmap-slot">
                                    <DartboardHeatmapElement/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="checkout-challenge-panel" class="sub-panel" style="display: none;">
                        <ui:VisualElement class="columns">
                            <ui:VisualElement class="col-side col-side--left panel panel--grow">
                                <ui:Label text="Checkout route" class="section-title"/>
                                <ui:Label name="co-ch-route" text="–" class="finish-route finish-route--primary"/>
                                <ui:VisualElement class="divider"/>
                                <ui:ScrollView class="scroll">
                                    <ui:VisualElement name="co-ch-history-container">
                                        <ui:VisualElement class="list-row">
                                            <ui:Label name="score" text="40" class="list-row__darts"/>
                                            <ui:Label name="darts" text="3D" class="list-row__score"/>
                                            <ui:Label name="result" text="Hit" class="list-row__rem"/>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-main">
                                <ui:VisualElement class="panel">
                                    <ui:VisualElement class="fields-row">
                                        <ui:TextField name="co-ch-dart-field-0" label="Dart 1" class="dart-field"/>
                                        <ui:TextField name="co-ch-dart-field-1" label="Dart 2" class="dart-field"/>
                                        <ui:TextField name="co-ch-dart-field-2" label="Dart 3" class="dart-field dart-field--last"/>
                                    </ui:VisualElement>
                                    <ui:Label name="co-ch-feedback" text="" class="feedback"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="list-block panel--center">
                                    <ui:Label text="Score" class="stat-caption"/>
                                    <ui:Label name="co-ch-current-score" text="21" class="stat-value stat-value--big"/>
                                    <ui:Label text="High score" class="stat-caption"/>
                                    <ui:Label name="co-ch-highscore" text="21" class="stat-value stat-value--small"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="button-row">
                                    <ui:Button name="co-ch-btn-new" text="New session" class="text-button text-button--primary button-row__gap"/>
                                    <ui:Button name="co-ch-btn-reset" text="Reset session" class="text-button text-button--danger"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-side panel panel--grow">
                                <ui:Label text="Session stats" class="section-title"/>
                                <ui:VisualElement class="stat-grid">
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-ch-stat-hitrate" text="–" class="stat-value"/>
                                        <ui:Label text="Hit rate" class="stat-caption"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-ch-stat-attempts" text="–" class="stat-value"/>
                                        <ui:Label text="Attempts" class="stat-caption"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-grid">
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-ch-stat-avg-darts" text="–" class="stat-value"/>
                                        <ui:Label text="Avg darts (hit)" class="stat-caption"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-ch-stat-best" text="–" class="stat-value"/>
                                        <ui:Label text="Best score" class="stat-caption"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="co-ch-heatmap-container" class="heatmap-slot">
                                    <DartboardHeatmapElement/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement name="checkout-five-panel" class="sub-panel" style="display: none;">
                        <ui:VisualElement class="columns">
                            <ui:VisualElement class="col-side col-side--left panel panel--grow">
                                <ui:Label text="Difficulty" class="section-title"/>
                                <ui:VisualElement class="tab-strip">
                                    <ui:Button name="co-five-diff-0" text="Easy" class="stats-inner-tab stats-inner-tab--active"/>
                                    <ui:Button name="co-five-diff-1" text="Medium" class="stats-inner-tab"/>
                                    <ui:Button name="co-five-diff-2" text="Hard" class="stats-inner-tab"/>
                                    <ui:Button name="co-five-diff-3" text="Expert" class="stats-inner-tab"/>
                                </ui:VisualElement>
                                <ui:Label text="Checkouts" class="section-title"/>
                                <ui:VisualElement name="co-five-cards-container" class="scroll">
                                    <ui:VisualElement class="five-card five-card--done">
                                        <ui:Label name="score" text="41" class="five-card__score"/>
                                        <ui:Label name="status" text="Done" class="five-card__status"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="five-card five-card--active">
                                        <ui:Label name="score" text="52" class="five-card__score"/>
                                        <ui:Label name="status" text="Now" class="five-card__status"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="five-card">
                                        <ui:Label name="score" text="60" class="five-card__score"/>
                                        <ui:Label name="status" text="-" class="five-card__status"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="five-card">
                                        <ui:Label name="score" text="68" class="five-card__score"/>
                                        <ui:Label name="status" text="-" class="five-card__status"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="five-card">
                                        <ui:Label name="score" text="77" class="five-card__score"/>
                                        <ui:Label name="status" text="-" class="five-card__status"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-main">
                                <ui:VisualElement class="panel">
                                    <ui:VisualElement class="fields-row">
                                        <ui:TextField name="co-five-dart-field-0" label="Dart 1" class="dart-field"/>
                                        <ui:TextField name="co-five-dart-field-1" label="Dart 2" class="dart-field"/>
                                        <ui:TextField name="co-five-dart-field-2" label="Dart 3" class="dart-field dart-field--last"/>
                                    </ui:VisualElement>
                                    <ui:Label name="co-five-feedback" text="" class="feedback"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="list-block panel--center">
                                    <ui:Label text="Route" class="stat-caption"/>
                                    <ui:Label name="co-five-route" text="–" class="finish-route finish-route--primary"/>
                                    <ui:Label name="co-five-progress" text="0 / 5" class="stat-value"/>
                                </ui:VisualElement>
                                <ui:VisualElement class="button-row">
                                    <ui:Button name="co-five-btn-new" text="New game" class="text-button text-button--primary button-row__gap"/>
                                    <ui:Button name="co-five-btn-reset" text="Reset" class="text-button text-button--danger"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="col-side panel panel--grow">
                                <ui:Label text="Session stats" class="section-title"/>
                                <ui:VisualElement class="stat-grid">
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-five-stat-completed" text="0 / 5" class="stat-value"/>
                                        <ui:Label text="Completed" class="stat-caption"/>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-block">
                                        <ui:Label name="co-five-stat-attempts" text="–" class="stat-value"/>
                                        <ui:Label text="Attempts" class="stat-caption"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="co-five-heatmap-container" class="heatmap-slot">
