                                <ui:Label name="tg-ai-dart-1" text="" style="font-size: 26px; -unity-font-style: bold; color: rgb(220, 80, 60); min-width: 54px; -unity-text-align: upper-center;"/>
                                <ui:Label name="tg-ai-dart-2" text="" style="font-size: 26px; -unity-font-style: bold; color: rgb(220, 80, 60); min-width: 54px; -unity-text-align: upper-center;"/>
                            </ui:VisualElement>
                            <ui:Label name="tg-ai-last-score" text="" style="font-size: 14px; color: rgb(150, 60, 40); -unity-text-align: upper-center;"/>
