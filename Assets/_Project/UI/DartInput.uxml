                        <ui:VisualElement class="card" style="flex-grow: 1; padding: 20px; flex-direction: column;">
                            <ui:VisualElement name="tg-score-block" style="align-items: center; margin-bottom: 12px;">
                                <ui:Label text="Mein Rest" class="stat-caption"/>
                                <ui:Label name="tg-current-score" text="501" style="font-size: 56px; -unity-font-style: bold; color: rgb(78, 205, 196);"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="tg-throws-header" style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                                <ui:Label text="Meine Würfe" style="flex-grow: 1; font-size: 15px; color: rgb(28, 43, 74); -unity-font-style: bold;"/>
                                <ui:Button name="tg-btn-remove-last" text="Remove Last" style="padding: 4px 10px;"/>
                            </ui:VisualElement>
                            <ui:ScrollView name="tg-throws-scroll" style="flex-grow: 1;">
                                <ui:VisualElement name="tg-throws-container"/>
