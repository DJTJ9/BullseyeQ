                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ── Training plan ───────────────────────────────────── -->
            <ui:VisualElement name="panel-training-plan" class="content-panel" style="display: none;">
                <ui:Label text="Training plan" class="panel-title"/>
                <ui:Label text="Based on your last 10 sessions" class="section-title"/>
                <ui:ScrollView class="scroll">
                    <ui:VisualElement name="tp-no-data" class="empty-state">
                        <ui:Label text="Not enough data yet" class="empty-state__title"/>
                        <ui:Label text="Complete at least 3 sessions to get a personalised training plan." class="empty-state__text"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="tp-rec-container"/>
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- ── Stats & analytics ───────────────────────────────── -->
            <ui:VisualElement name="panel-stats" class="content-panel" style="display: none;">
                <ui:Label text="Stats &amp; analytics" class="panel-title"/>
                <ui:VisualElement class="tab-strip">
                    <ui:Button name="stats-tab-scoring" text="Scoring" class="stats-inner-tab stats-inner-tab--active"/>
                    <ui:Button name="stats-tab-fo" text="501" class="stats-inner-tab"/>
                    <ui:Button name="stats-tab-doubles" text="Doubles" class="stats-inner-tab"/>
                    <ui:Button name="stats-tab-tg" text="Training game" class="stats-inner-tab"/>
                </ui:VisualElement>

                <ui:VisualElement name="stats-scoring-panel" class="sub-panel">
                    <ui:VisualElement class="columns">
                        <ui:VisualElement class="col-main col-main--wide">
                            <ui:Label text="Avg score per session" class="section-title"/>
                            <ui:VisualElement name="chart-avg-score" class="chart-container">
                                <LineChartElement line-color="#2FBF71"/>
                            </ui:VisualElement>
                            <ui:Label text="Triple rate %" class="section-title"/>
