                                    <ui:Label text="Fin" class="list-row__cell"/>
                                    <ui:Label text="CO%" class="list-row__cell"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="tg-recent-sessions-container">
                                    <ui:VisualElement class="list-row">
                                        <ui:Label name="cell0" text="27" class="list-row__cell"/>
                                        <ui:Label name="cell1" text="55.7" class="list-row__cell"/>
                                        <ui:Label name="cell2" text="24" class="list-row__cell"/>
                                        <ui:Label name="cell3" text="33%" class="list-row__cell"/>
