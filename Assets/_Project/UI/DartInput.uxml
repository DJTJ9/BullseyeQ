<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/TrainingsSessionStyle.uss?fileID=7433441132597879392&amp;guid=9a9be5dd932fff3458eb8d3e02cba2be&amp;type=3#TrainingsSessionStyle"/>
    <ui:Template name="Panel_Overview" src="Panels/Panel_Overview.uxml"/>
    <ui:Template name="Panel_TrainingGame" src="Panels/Panel_TrainingGame.uxml"/>
    <ui:Template name="Panel_Sessions" src="Panels/Panel_Sessions.uxml"/>
    <ui:Template name="Panel_TrainingPlan" src="Panels/Panel_TrainingPlan.uxml"/>
    <ui:Template name="Panel_Stats" src="Panels/Panel_Stats.uxml"/>
    <ui:Template name="Panel_Settings" src="Panels/Panel_Settings.uxml"/>
    <ui:VisualElement name="root">
        <StageVignetteElement name="stage-bg"/>

        <!-- ── Sidebar ─────────────────────────────────────────────── -->
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:VisualElement name="nav-marker" class="nav-marker"/>
            <ui:Image name="sidebar-logo" class="sidebar__logo" src="project://database/Assets/_Project/Art/BullseyeQ-Logo.png"/>
            <ui:Button name="nav-overview" text="Overview" class="nav-item"/>
            <ui:Button name="nav-training-game" text="Training game" class="nav-item"/>
            <ui:Button name="nav-training-sessions" text="Training sessions" class="nav-item"/>
            <ui:Button name="nav-training-plan" text="Training plan" class="nav-item"/>
            <ui:Button name="nav-stats" text="Stats &amp; analytics" class="nav-item"/>
            <ui:Button name="nav-settings" text="Settings" class="nav-item"/>
            <ui:VisualElement class="scroll"/>
            <ui:Button name="nav-quit" text="Quit" class="nav-item nav-item--quit"/>
        </ui:VisualElement>

        <ui:VisualElement name="content-area" class="content-area">

            <!-- ── Overview ────────────────────────────────────────── -->
            <ui:Instance template="Panel_Overview" name="panel-overview" class="content-panel"/>

            <!-- ── Training game ───────────────────────────────────── -->
            <ui:Instance template="Panel_TrainingGame" name="panel-training-game" class="content-panel"/>

            <!-- ── Training sessions ───────────────────────────────── -->
            <ui:Instance template="Panel_Sessions" name="panel-training-sessions" class="content-panel"/>

            <!-- ── Training plan ───────────────────────────────────── -->
            <ui:Instance template="Panel_TrainingPlan" name="panel-training-plan" class="content-panel"/>

            <!-- ── Stats & analytics ───────────────────────────────── -->
            <ui:Instance template="Panel_Stats" name="panel-stats" class="content-panel"/>

            <!-- ── Settings ────────────────────────────────────────── -->
            <ui:Instance template="Panel_Settings" name="panel-settings" class="content-panel"/>
        </ui:VisualElement>

        <!-- ── Root-level overlays (cover the sidebar too) ─────────── -->
        <ui:VisualElement name="tg-game-over-overlay" class="modal-overlay">
            <ui:VisualElement class="modal-box">
                <ui:Label name="tg-game-over-title" text="" class="game-over-title"/>
                <ui:Label name="tg-game-over-subtitle" text="" class="game-over-sub"/>
                <ui:Button name="tg-btn-ok" text="OK" class="text-button text-button--primary"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="modal-overlay" class="modal-overlay">
            <ui:VisualElement name="modal-box" class="modal-box">
                <ui:Label text="Delete all stats? This can't be undone." class="modal-message"/>
                <ui:VisualElement class="modal-buttons">
                    <ui:Button name="modal-btn-cancel" text="Cancel" class="text-button"/>
                    <ui:Button name="modal-btn-yes" text="Delete" class="text-button text-button--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="lower-third" class="lower-third" picking-mode="Ignore">
            <ui:Label name="lower-third-label" text="" class="lower-third__label"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
