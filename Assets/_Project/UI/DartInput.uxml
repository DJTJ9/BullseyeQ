                                <LineChartElement line-color="#F2A93B"/>
                            </ui:VisualElement>
                            <ui:Label text="Wasted darts %" class="section-title"/>
                            <ui:VisualElement name="chart-wasted-rate" class="chart-container">
                                <LineChartElement line-color="#E5202B"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-main">
                            <ui:Label text="Score distribution" class="section-title"/>
                            <ui:Label name="score-dist-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="score-dist-container"/>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Lifetime" class="section-title"/>
                            <ui:Label name="scoring-lifetime-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="scoring-lifetime-container"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-side">
                            <ui:Label text="Overall heatmap" class="section-title"/>
                            <ui:VisualElement name="stats-scoring-heatmap" class="heatmap-slot">
                                <DartboardHeatmapElement/>
                            </ui:VisualElement>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Session history" class="section-title"/>
                            <ui:ScrollView name="scoring-history-scroll" class="scroll">
                                <ui:Label name="scoring-history-empty" text="No data yet" class="placeholder-text"/>
                                <ui:VisualElement name="scoring-history-header" class="list-row list-row--header">
                                    <ui:Label text="Date" class="list-row__cell list-row__cell--fixed hist-scoring__date"/>
                                    <ui:Label text="Avg" class="list-row__cell list-row__cell--fixed hist-scoring__avg"/>
                                    <ui:Label text="180s" class="list-row__cell list-row__cell--fixed hist-scoring__180"/>
                                    <ui:Label text="Visits" class="list-row__cell list-row__cell--fixed hist-scoring__visits"/>
                                    <ui:Label text="" class="list-row__cell list-row__cell--fixed hist__del"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="scoring-history-container"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="stats-fo-panel" class="sub-panel" style="display: none;">
                    <ui:VisualElement class="columns">
                        <ui:VisualElement class="col-main col-main--wide">
                            <ui:Label text="3-dart average per leg" class="section-title"/>
                            <ui:VisualElement name="chart-fo-avg" class="chart-container">
                                <LineChartElement line-color="#2FBF71"/>
                            </ui:VisualElement>
                            <ui:Label text="Checkout rate %" class="section-title"/>
                            <ui:VisualElement name="chart-fo-checkout" class="chart-container">
                                <LineChartElement line-color="#F2A93B"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-main">
                            <ui:Label text="501 stats" class="section-title"/>
                            <ui:Label name="fo-stats-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="fo-stats-container"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-side">
                            <ui:Label text="Overall heatmap" class="section-title"/>
                            <ui:VisualElement name="stats-fo-heatmap" class="heatmap-slot">
                                <DartboardHeatmapElement/>
                            </ui:VisualElement>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Session history" class="section-title"/>
                            <ui:ScrollView name="fo-history-scroll" class="scroll">
                                <ui:Label name="fo-history-empty" text="No data yet" class="placeholder-text"/>
                                <ui:VisualElement name="fo-history-header" class="list-row list-row--header">
                                    <ui:Label text="Date" class="list-row__cell list-row__cell--fixed hist-fo__date"/>
                                    <ui:Label text="3DA" class="list-row__cell list-row__cell--fixed hist-fo__3da"/>
                                    <ui:Label text="CO%" class="list-row__cell list-row__cell--fixed hist-fo__co"/>
                                    <ui:Label text="Result" class="list-row__cell list-row__cell--fixed hist-fo__result"/>
                                    <ui:Label text="" class="list-row__cell list-row__cell--fixed hist__del"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="fo-history-container"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="stats-doubles-panel" class="sub-panel" style="display: none;">
                    <ui:VisualElement class="columns">
                        <ui:VisualElement class="col-main col-main--wide">
                            <ui:Label text="Hit rate trend" class="section-title"/>
                            <ui:VisualElement name="chart-co-hitrate" class="chart-container">
                                <LineChartElement line-color="#2FBF71"/>
                            </ui:VisualElement>
                            <ui:Label text="High score trend (challenge)" class="section-title"/>
                            <ui:VisualElement name="chart-co-highscore" class="chart-container">
                                <LineChartElement line-color="#F2A93B"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-main">
                            <ui:Label text="Mode distribution" class="section-title"/>
                            <ui:Label name="co-dist-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="co-dist-container"/>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Lifetime" class="section-title"/>
                            <ui:Label name="co-lifetime-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="co-lifetime-container"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-side">
                            <ui:Label text="Overall heatmap" class="section-title"/>
                            <ui:VisualElement name="stats-co-heatmap" class="heatmap-slot">
                                <DartboardHeatmapElement/>
                            </ui:VisualElement>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Session history" class="section-title"/>
                            <ui:ScrollView name="co-history-scroll" class="scroll">
                                <ui:Label name="co-history-empty" text="No data yet" class="placeholder-text"/>
                                <ui:VisualElement name="co-history-header" class="list-row list-row--header">
                                    <ui:Label text="Date" class="list-row__cell list-row__cell--fixed hist-co__date"/>
                                    <ui:Label text="Mode" class="list-row__cell list-row__cell--fixed hist-co__mode"/>
                                    <ui:Label text="Hit%" class="list-row__cell list-row__cell--fixed hist-co__hit"/>
                                    <ui:Label text="Attempts" class="list-row__cell list-row__cell--fixed hist-co__attempts"/>
                                    <ui:Label text="" class="list-row__cell list-row__cell--fixed hist__del"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="co-history-container"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="stats-tg-panel" class="sub-panel" style="display: none;">
                    <ui:VisualElement class="columns">
                        <ui:VisualElement class="col-main col-main--wide">
                            <ui:Label text="Win rate trend" class="section-title"/>
                            <ui:VisualElement name="chart-tg-winrate" class="chart-container">
                                <LineChartElement line-color="#2FBF71"/>
                            </ui:VisualElement>
                            <ui:Label text="3-dart average (you)" class="section-title"/>
                            <ui:VisualElement name="chart-tg-avg" class="chart-container">
                                <LineChartElement line-color="#F2A93B"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-main">
                            <ui:Label text="Training game stats" class="section-title"/>
                            <ui:Label name="tg-stats-empty" text="No data yet" class="placeholder-text"/>
                            <ui:VisualElement name="tg-stats-container"/>
                            <ui:VisualElement class="divider"/>
                            <ui:Label text="Overall heatmap" class="section-title"/>
                            <ui:VisualElement name="stats-tg-heatmap" class="heatmap-slot">
                                <DartboardHeatmapElement/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="col-main col-main--wide col-main--last">
                            <ui:Label text="Match history (last 10)" class="section-title"/>
                            <ui:ScrollView name="tg-history-scroll" class="scroll">
                                <ui:Label name="tg-history-empty" text="No data yet" class="placeholder-text"/>
                                <ui:VisualElement name="tg-history-header" class="list-row list-row--header">
                                    <ui:Label text="Date" class="list-row__cell list-row__cell--fixed hist-tg__date"/>
                                    <ui:Label text="You" class="list-row__cell list-row__cell--fixed hist-tg__you"/>
                                    <ui:Label text="AI" class="list-row__cell list-row__cell--fixed hist-tg__ai"/>
                                    <ui:Label text="CO%" class="list-row__cell list-row__cell--fixed hist-tg__co"/>
                                    <ui:Label text="Result" class="list-row__cell list-row__cell--fixed hist-tg__result"/>
                                    <ui:Label text="" class="list-row__cell list-row__cell--fixed hist__del"/>
                                </ui:VisualElement>
                                <ui:VisualElement name="tg-history-container"/>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ── Settings ────────────────────────────────────────── -->
            <ui:VisualElement name="panel-settings" class="content-panel" style="display: none;">
                <ui:Label text="Settings" class="panel-title"/>
                <ui:VisualElement class="settings-body">
                    <ui:VisualElement class="settings-row">
                        <ui:VisualElement>
                            <ui:Label text="Reduce motion" class="settings-row__label"/>
                            <ui:Label text="Turns off screen transitions and score animations." class="settings-row__hint"/>
                        </ui:VisualElement>
                        <ui:Toggle name="settings-toggle-motion" class="motion-toggle"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:VisualElement>
                            <ui:Label text="Reset stats" class="settings-row__label"/>
                            <ui:Label text="Deletes every session, leg and match." class="settings-row__hint"/>
                        </ui:VisualElement>
                        <ui:Button name="settings-btn-reset-stats" text="Reset stats" class="text-button text-button--danger"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── Root-level overlays (cover the sidebar too) ─────────── -->
        <ui:VisualElement name="tg-game-over-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-box">
                <ui:Label name="tg-game-over-title" text="" class="game-over-title"/>
                <ui:Label name="tg-game-over-subtitle" text="" class="game-over-sub"/>
                <ui:Button name="tg-btn-ok" text="OK" class="text-button text-button--primary"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="modal-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement name="modal-box" class="modal-box">
                <ui:Label text="Delete all stats? This can't be undone." class="modal-message"/>
                <ui:VisualElement class="modal-buttons">
                    <ui:Button name="modal-btn-cancel" text="Cancel" class="text-button"/>
                    <ui:Button name="modal-btn-yes" text="Delete" class="text-button text-button--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="lower-third" class="lower-third" picking-mode="Ignore">
            <ui:Label name="lower-third-label" text="" class="lower-third__label"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
