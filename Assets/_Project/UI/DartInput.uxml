<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/TrainingsSessionStyle.uss?fileID=7433441132597879392&amp;guid=9a9be5dd932fff3458eb8d3e02cba2be&amp;type=3#TrainingsSessionStyle"/>
    <ui:VisualElement name="root" style="width: 100%; height: 100%; flex-direction: row;">
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:VisualElement name="logo-area" class="sidebar__logo-area">
                <ui:Image name="sidebar-logo" src="project://database/Assets/_Project/Art/BullseyeQ-Logo.png" style="width: 219px; height: 150px; -unity-background-scale-mode: scale-to-fit; flex-grow: 0;"/>
            </ui:VisualElement>
            <ui:Button name="nav-overview" text="Overview" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:Button name="nav-training-game" text="Training Game" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:Button name="nav-training-sessions" text="Training Sessions" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:Button name="nav-training-plan" text="Training Plan" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:Button name="nav-stats" text="Stats &amp; Analytics" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:Button name="nav-settings" text="Settings" class="nav-item" style="-unity-font-style: bold;"/>
            <ui:VisualElement style="flex-grow: 1;"/>
            <ui:Button name="nav-quit" text="Quit" class="nav-item nav-item--quit" style="bottom: 5%; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="content-area" class="content-area">
            <ui:VisualElement name="panel-overview" class="content-panel" style="display: flex;">
                <ui:VisualElement class="input-header">
                    <ui:Label text="Overview" class="panel-header-title"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; padding: 16px 16px 0; flex-shrink: 0;">
                    <ui:VisualElement class="hero-card" style="flex-grow: 1; margin-right: 12px;">
                        <ui:Label text="Ø Lifetime" class="hero-caption"/>
                        <ui:Label name="ov-lifetime-avg" text="–" class="hero-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hero-card" style="flex-grow: 1; margin-right: 12px;">
                        <ui:Label text="Sessions" class="hero-caption"/>
                        <ui:Label name="ov-session-count" text="–" class="hero-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hero-card" style="flex-grow: 1; margin-right: 12px;">
                        <ui:Label text="Ø letzte 5" class="hero-caption"/>
                        <ui:Label name="ov-rolling-avg" text="–" class="hero-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hero-card" style="flex-grow: 1;">
                        <ui:Label text="Trend" class="hero-caption"/>
                        <ui:Label name="ov-trend" text="–" class="hero-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="card" style="flex-shrink: 0; margin-top: 12px; margin-left: 16px; margin-right: 16px; padding: 16px 20px;">
                    <ui:Label text="Letzte Sessions" class="section-title"/>
                    <ui:VisualElement name="ov-recent-container"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; padding: 12px 16px 16px;">
                    <ui:VisualElement class="card" style="flex-grow: 1; padding: 20px; margin-right: 16px;">
                        <ui:Label text="Bestleistungen" class="section-title"/>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                            <ui:Label text="Bestes Ø Session" class="stat-caption"/>
                            <ui:Label name="ov-best-session-avg" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                            <ui:Label text="Höchste Runde" class="stat-caption"/>
                            <ui:Label name="ov-best-round" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                            <ui:Label text="180er gesamt" class="stat-caption"/>
                            <ui:Label name="ov-total-180s" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                            <ui:Label text="140+ gesamt" class="stat-caption"/>
                            <ui:Label name="ov-total-140s" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 10px;">
                            <ui:Label text="100+ gesamt" class="stat-caption"/>
                            <ui:Label name="ov-total-100s" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                            <ui:Label text="Würfe gesamt" class="stat-caption"/>
                            <ui:Label name="ov-total-rounds" text="–" class="stat-value" style="font-size: 18px;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex-grow: 1; padding: 20px;">
                        <ui:Label text="Gesamt-Heatmap" class="section-title"/>
                        <ui:VisualElement name="ov-heatmap-container" style="flex-grow: 1;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="panel-training-game" class="content-panel" style="display: none;">
                <ui:VisualElement class="input-header">
                    <ui:Label text="Training Game" class="panel-header-title"/>
                </ui:VisualElement>
                <ui:VisualElement name="tg-bottom-section" class="bottom-section" style="flex-direction: row; flex-grow: 1;">
                    <ui:VisualElement name="tg-finishes-section" class="card" style="flex-grow: 1; padding: 20px; margin-right: 16px; width: 25%; min-width: 25%; max-width: 25%;">
                        <ui:Label text="Mögliche Finishes" class="section-title"/>
                        <ui:ScrollView name="tg-finishes-scroll" style="flex-grow: 1;">
                            <ui:VisualElement name="tg-finishes-container">
