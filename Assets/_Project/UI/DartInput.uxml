                            <ui:Label text="Letzte Legs (Referenz)" style="font-size: 15px; color: rgb(28, 43, 74); -unity-font-style: bold; margin-top: 10px; margin-bottom: 6px;"/>
                            <ui:ScrollView name="tg-recent-sessions-scroll" style="height: 140px; flex-shrink: 0;">
                                <ui:VisualElement name="tg-recent-sessions-container">
                                    <ui:Label text="Noch keine abgeschlossenen Legs." style="color: rgb(170, 170, 170); -unity-font-style: italic;"/>
                                </ui:VisualElement>
                            </ui:ScrollView>
                            <ui:VisualElement name="tg-session-buttons" style="flex-direction: row; justify-content: space-between; margin-top: 12px;">
                                <ui:Button name="tg-btn-new-game" text="New Game" style="flex-grow: 1; margin-right: 6px; padding: 8px 0;"/>
                                <ui:Button name="tg-btn-reset-game" text="Reset Game" style="flex-grow: 1; margin-left: 6px; padding: 8px 0;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="tg-ai-section" class="card" style="flex-grow: 1; padding: 20px; flex-direction: column; width: 25%; min-width: 25%; max-width: 25%;">
