                                        <ui:Label name="darts" text="T20  S20  S5" class="list-row__darts"/>
                                        <ui:Label name="score" text="85" class="list-row__score"/>
                                        <ui:Label name="rem" text="416" class="list-row__rem"/>
                                    </ui:VisualElement>
                                </ui:VisualElement>
