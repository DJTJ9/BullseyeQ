                            <ui:VisualElement name="tg-fields-row" style="flex-direction: row; align-items: flex-end;">
                                <ui:TextField name="tg-dart-field-0" label="Dart 1" style="flex-grow: 1; margin-right: 12px; font-size: 24px; -unity-font-style: bold; -unity-text-align: upper-center;"/>
                                <ui:TextField name="tg-dart-field-1" label="Dart 2" style="flex-grow: 1; margin-right: 12px; font-size: 24px; -unity-font-style: bold; -unity-text-align: upper-center;"/>
                                <ui:TextField name="tg-dart-field-2" label="Dart 3" style="flex-grow: 1; font-size: 24px; -unity-font-style: bold; -unity-text-align: upper-center;"/>
                            </ui:VisualElement>
                            <ui:Label name="tg-feedback-label" text="" style="color: rgb(255, 200, 200); margin-top: 8px; white-space: normal;"/>
