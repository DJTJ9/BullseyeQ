<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/TrainingsSessionStyle.uss?fileID=7433441132597879392&amp;guid=9a9be5dd932fff3458eb8d3e02cba2be&amp;type=3#TrainingsSessionStyle"/>
    <ui:VisualElement name="bottom-section" class="columns">
        <ui:VisualElement class="col-main">
            <ui:VisualElement name="input-section" class="panel">
                <ui:VisualElement name="fields-row" class="fields-row">
                    <ui:TextField name="dart-field-0" label="Dart 1" class="dart-field"/>
                    <ui:TextField name="dart-field-1" label="Dart 2" class="dart-field"/>
                    <ui:TextField name="dart-field-2" label="Dart 3" class="dart-field dart-field--last"/>
                </ui:VisualElement>
                <ui:Label name="feedback-label" text="" class="feedback"/>
            </ui:VisualElement>
            <ui:VisualElement name="rounds-section" class="list-block">
                <ui:VisualElement name="rounds-header" class="list-header">
                    <ui:Label text="Throw history" class="list-title"/>
                    <ui:Button name="btn-remove-last" text="Undo last" class="text-button text-button--small"/>
                </ui:VisualElement>
                <ui:ScrollView name="rounds-scroll" class="scroll">
                    <ui:VisualElement name="rounds-container"/>
                </ui:ScrollView>
                <ui:VisualElement name="session-buttons" class="button-row">
                    <ui:Button name="btn-new-session" text="New session" class="text-button text-button--primary button-row__gap"/>
                    <ui:Button name="btn-reset-session" text="Reset session" class="text-button text-button--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="stats-section" class="col-side panel panel--grow">
            <ui:Label text="Session stats" class="section-title"/>
            <ui:VisualElement class="stat-grid">
                <ui:VisualElement class="stat-block">
                    <ui:Label name="stat-avg-session" text="–" class="stat-value"/>
                    <ui:Label text="Session avg" class="stat-caption"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-block">
                    <ui:Label name="stat-avg-rolling" text="–" class="stat-value"/>
                    <ui:Label text="Last 5 avg" class="stat-caption"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="stat-grid">
                <ui:VisualElement class="stat-block">
                    <ui:Label name="stat-triple-rate" text="–" class="stat-value"/>
                    <ui:Label text="Triple rate" class="stat-caption"/>
                </ui:VisualElement>
                <ui:VisualElement class="stat-block">
                    <ui:Label name="stat-wasted-rate" text="–" class="stat-value"/>
                    <ui:Label text="Wasted darts" class="stat-caption"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="heatmap-container" class="heatmap-slot"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
