<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/TrainingsSessionStyle.uss?fileID=7433441132597879392&amp;guid=9a9be5dd932fff3458eb8d3e02cba2be&amp;type=3#TrainingsSessionStyle"/>
    <ui:VisualElement class="columns">
        <ui:VisualElement class="col-main col-main--wide">
            <ui:Label text="Win rate trend" class="section-title"/>
            <ui:VisualElement name="chart-tg-winrate" class="chart-container"/>
            <ui:Label text="3-dart average (you)" class="section-title"/>
            <ui:VisualElement name="chart-tg-avg" class="chart-container"/>
        </ui:VisualElement>
        <ui:VisualElement class="col-main">
            <ui:Label text="Training game stats" class="section-title"/>
            <ui:Label name="tg-stats-empty" text="No data yet" class="placeholder-text"/>
            <ui:VisualElement name="tg-stats-container"/>
            <ui:VisualElement class="divider"/>
            <ui:Label text="Overall heatmap" class="section-title"/>
            <ui:VisualElement name="stats-tg-heatmap" class="heatmap-slot"/>
        </ui:VisualElement>
        <ui:VisualElement class="col-main col-main--wide col-main--last">
            <ui:Label text="Match history (last 10)" class="section-title"/>
            <ui:ScrollView name="tg-history-scroll" class="scroll">
                <ui:Label name="tg-history-empty" text="No data yet" class="placeholder-text"/>
                <ui:VisualElement name="tg-history-header" class="list-row list-row--header">
                    <ui:Label text="Date" class="list-row__cell list-row__cell--fixed hist-tg__date"/>
                    <ui:Label text="You" class="list-row__cell list-row__cell--fixed hist-tg__you"/>
                    <ui:Label text="AI" class="list-row__cell list-row__cell--fixed hist-tg__ai"/>
                    <ui:Label text="CO%" class="list-row__cell list-row__cell--fixed hist-tg__co"/>
                    <ui:Label text="Result" class="list-row__cell list-row__cell--fixed hist-tg__result"/>
                    <ui:Label text="" class="list-row__cell list-row__cell--fixed hist__del"/>
                </ui:VisualElement>
                <ui:VisualElement name="tg-history-container"/>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
