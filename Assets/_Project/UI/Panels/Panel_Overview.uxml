<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/TrainingsSessionStyle.uss?fileID=7433441132597879392&amp;guid=9a9be5dd932fff3458eb8d3e02cba2be&amp;type=3#TrainingsSessionStyle"/>
    <ui:Label text="Overview" class="panel-title"/>
    <ui:VisualElement class="hero-row">
        <ui:VisualElement class="hero">
            <ui:Label name="ov-lifetime-avg" text="–" class="hero-value"/>
            <ui:Label text="Lifetime avg" class="hero-caption"/>
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:Label name="ov-session-count" text="–" class="hero-value"/>
            <ui:Label text="Sessions" class="hero-caption"/>
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:Label name="ov-rolling-avg" text="–" class="hero-value"/>
            <ui:Label text="Last 5 avg" class="hero-caption"/>
        </ui:VisualElement>
        <ui:VisualElement class="hero">
            <ui:Label name="ov-trend" text="–" class="hero-value"/>
            <ui:Label text="Trend" class="hero-caption"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement class="divider"/>
    <ui:VisualElement class="columns">
        <ui:VisualElement class="col-main">
            <ui:Label text="Recent sessions" class="section-title"/>
            <ui:Label name="ov-recent-empty" text="No finished sessions yet." class="placeholder-text"/>
            <ui:VisualElement name="ov-recent-header" class="list-row list-row--header">
                <ui:Label text="Date" class="list-row__cell"/>
                <ui:Label text="Visits" class="list-row__cell"/>
                <ui:Label text="Avg" class="list-row__cell"/>
                <ui:Label text="Triple %" class="list-row__cell"/>
            </ui:VisualElement>
            <ui:VisualElement name="ov-recent-container"/>
            <ui:VisualElement class="divider"/>
            <ui:Label text="Personal bests" class="section-title"/>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Best session avg" class="stat-row__label"/>
                <ui:Label name="ov-best-session-avg" text="–" class="stat-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Highest visit" class="stat-row__label"/>
                <ui:Label name="ov-best-round" text="–" class="stat-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Total 180s" class="stat-row__label"/>
                <ui:Label name="ov-total-180s" text="–" class="stat-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Total 140+" class="stat-row__label"/>
                <ui:Label name="ov-total-140s" text="–" class="stat-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Total 100+" class="stat-row__label"/>
                <ui:Label name="ov-total-100s" text="–" class="stat-row__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="stat-row">
                <ui:Label text="Total visits" class="stat-row__label"/>
                <ui:Label name="ov-total-rounds" text="–" class="stat-row__value"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="col-side">
            <ui:Label text="Overall heatmap" class="section-title"/>
            <ui:VisualElement name="ov-heatmap-container" class="heatmap-slot"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
