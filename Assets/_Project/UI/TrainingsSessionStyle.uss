/* ═══════════════════════════════════════════════════════════════════════
   BullseyeQ — Pub-green game theme
   Tokens mirror UiTheme.cs. Change both together.
   ═══════════════════════════════════════════════════════════════════════ */

:root, #root {
    --bq-stage: #0F3B2E;
    --bq-stage-edge: #0A2A20;
    --bq-panel: #17503E;
    --bq-line: #2A6B53;
    --bq-text: #F4EBD6;
    --bq-muted: #A9BFB2;
    --bq-live: #D7262E;
    --bq-live-dim: rgba(215, 38, 46, 0.12);
    --bq-live-text: #FF9E94;
    --bq-ai: #2D9CDB;
    --bq-hit: #9BE870;
    --bq-warm: #E8B64A;
    --bq-wood: #7A4E2D;
    --bq-slate: #1C2B25;
    --bq-tile-hover: #1F6B50;
    --bq-hover: rgba(255, 255, 255, 0.04);

    --bq-radius: 4px;
    --bq-dur-exit: 120ms;
    --bq-dur-enter: 220ms;
    --bq-dur-marker: 200ms;
    --bq-dur-pop: 90ms;
    --bq-dur-shake: 50ms;
    --bq-dur-flash: 400ms;
    --bq-dur-banner: 250ms;
    --bq-dur-card: 200ms;
    --bq-dur-window-in: 220ms;
    --bq-dur-window-out: 120ms;
    --bq-dur-rule-fade: 400ms;
    --bq-dur-hover: 120ms;
    --bq-dur-press: 60ms;
    --bq-dur-board-in: 220ms;

    /* Game look: menu tiles + dashboard (tunable) */
    --bq-tile-size: 168px;
    --bq-tile-icon: 112px;
    --bq-tile-gap-half: 20px;
    --bq-tile-lift: 0 -4px;
    --bq-tile-press: 0 3px;
    --bq-logo-width: 42%;
    --bq-board-width: 58%;
    --bq-board-offset: 0 12px;

    --bq-fs-xs: 13px;
    --bq-fs-sm: 16px;
    --bq-fs-base: 18px;
    --bq-fs-md: 22px;
    --bq-fs-lg: 24px;
    --bq-fs-xl: 30px;
    --bq-fs-2xl: 40px;
    --bq-fs-3xl: 48px;
    --bq-fs-4xl: 68px;
    --bq-fs-5xl: 116px;
    --bq-fs-menu: 44px;
}

/* ── Base ─────────────────────────────────────────────────────────────── */

#root {
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: var(--bq-stage);
    color: var(--bq-text);
    font-size: var(--bq-fs-base);
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Medium.ttf");
    -unity-font-style: normal;
}

#root .unity-text-element {
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Medium.ttf");
    -unity-font-style: normal;
    color: var(--bq-text);
}

.t-reg     { -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf"); }
.t-cond    { -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.t-display { -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf"); }

/* Scrollbars */
.unity-scroller--vertical { width: 8px; }
.unity-scroller--horizontal { height: 8px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-base-slider__dragger {
    background-color: var(--bq-line);
    border-width: 0;
    border-radius: var(--bq-radius);
    width: 6px;
    left: 1px;
}
.unity-scroll-view__content-viewport { padding-right: 4px; }

/* ── Main menu: logo, icon tiles, dashboard ───────────────────────────── */
/* Text colour/font rules carry #root: `#root .unity-text-element` (1,1,0) would
   otherwise override a plain class selector. */

.main-menu {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 72px;
    padding-left: 64px;
    padding-right: 64px;
}

.menu-logo {
    width: var(--bq-logo-width);
    height: 26%;
    flex-shrink: 0;
    background-image: url("/Assets/_Project/Art/BullseyeQ-Logo-Alpha.png");
    -unity-background-scale-mode: scale-to-fit;
}

.menu-grid {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    flex-shrink: 0;
    margin-top: 24px;
}

.menu-tile {
    flex-direction: column;
    align-items: center;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: var(--bq-tile-gap-half);
    margin-right: var(--bq-tile-gap-half);
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    translate: 0 0;
    transition-property: translate;
    transition-duration: var(--bq-dur-hover);
    transition-timing-function: ease-out;
}
.menu-tile:hover,
.menu-tile:focus { translate: var(--bq-tile-lift); }

/* Dark base under the frame = the tile's thickness; the frame sinks into it on press. */
.menu-tile__base {
    padding-bottom: 6px;
    border-radius: 14px;
    background-color: var(--bq-stage-edge);
}

.menu-tile__frame {
    width: var(--bq-tile-size);
    height: var(--bq-tile-size);
    align-items: center;
    justify-content: center;
    background-image: url("/Assets/_Project/Art/UI/Button_Square03_White.png");
    -unity-background-image-tint-color: var(--bq-panel);
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    translate: 0 0;
    transition-property: translate, -unity-background-image-tint-color;
    transition-duration: var(--bq-dur-hover), var(--bq-dur-hover);
    transition-timing-function: ease-out;
}
.menu-tile:hover .menu-tile__frame,
.menu-tile:focus .menu-tile__frame,
.menu-tile--active .menu-tile__frame { -unity-background-image-tint-color: var(--bq-tile-hover); }
.menu-tile:active .menu-tile__frame {
    translate: var(--bq-tile-press);
    transition-duration: var(--bq-dur-press), var(--bq-dur-hover);
}

.menu-tile__icon {
    width: var(--bq-tile-icon);
    height: var(--bq-tile-icon);
    -unity-background-scale-mode: scale-to-fit;
}
.menu-tile__icon--game     { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Target.Png"); }
.menu-tile__icon--sessions { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Timer.Png"); }
.menu-tile__icon--plan     { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Scroll.Png"); }
.menu-tile__icon--stats    { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Trophy.Png"); }
.menu-tile__icon--settings { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Setting.Png"); }

#root .menu-tile__label {
    width: var(--bq-tile-size);
    margin-top: 12px;
    font-size: var(--bq-fs-lg);
    color: var(--bq-text);
    white-space: normal;
    -unity-text-align: upper-center;
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}

/* Oche marker: red bar under the focused/hovered tile, glides horizontally (UiFx.MoveNavMarker). */
.nav-marker {
    position: absolute;
    left: 0;
    bottom: -18px;
    width: 0;
    height: 6px;
    border-radius: 3px;
    background-color: var(--bq-live);
    transition-property: left, width;
    transition-duration: var(--bq-dur-marker);
    transition-timing-function: ease-out;
}

.menu-quit {
    position: absolute;
    right: 32px;
    bottom: 24px;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.menu-quit__icon {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    background-image: url("/Assets/_Project/Art/UI/Icon_PictoIcon_Exit.Png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--bq-muted);
}
.menu-quit:hover .menu-quit__icon,
.menu-quit:focus .menu-quit__icon { -unity-background-image-tint-color: var(--bq-live-text); }
#root .menu-quit__label { font-size: var(--bq-fs-base); color: var(--bq-muted); }
#root .menu-quit:hover .menu-quit__label,
#root .menu-quit:focus .menu-quit__label { color: var(--bq-live-text); }

/* ── Dashboard ────────────────────────────────────────────────────────── */

.dashboard {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    max-width: 1400px;
    margin-top: 56px;
    flex-shrink: 1;
    min-height: 0;
}

/* Today's practice: the one loud element — wood frame (9-slice, tinted), slate face, chalk text. */
.dash-board {
    width: var(--bq-board-width);
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    background-image: url("/Assets/_Project/Art/UI/BasicFrame_Square01_White.Png");
    -unity-background-image-tint-color: var(--bq-wood);
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--bq-dur-board-in);
    transition-timing-function: ease-out;
}
.dash-board--enter { opacity: 0; translate: var(--bq-board-offset); transition-duration: 0s; }

.dash-board__slate {
    background-color: var(--bq-slate);
    border-radius: 6px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
}
#root .dash-board__kicker {
    margin-bottom: 12px;
    font-size: var(--bq-fs-md);
    color: var(--bq-warm);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
.dash-board__row { flex-direction: row; align-items: flex-start; }
.dash-board__icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: 20px;
    -unity-background-scale-mode: scale-to-fit;
}
.dash-board__icon--scoring     { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Target.Png"); }
.dash-board__icon--triple      { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Arrow.Png"); }
.dash-board__icon--checkout    { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Medal_Gold.Png"); }
.dash-board__icon--consistency { background-image: url("/Assets/_Project/Art/UI/Icon_ItemIcon_Clover.Png"); }
.dash-board__text { flex-grow: 1; flex-shrink: 1; min-width: 0; }
#root .dash-board__title {
    font-size: var(--bq-fs-xl);
    color: var(--bq-text);
    white-space: normal;
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
#root .dash-board__reason { margin-top: 6px; font-size: var(--bq-fs-base); color: var(--bq-text); white-space: normal; }
#root .dash-board__action { margin-top: 4px; font-size: var(--bq-fs-sm); color: var(--bq-muted); white-space: normal; }
.dash-board__start { align-self: flex-end; margin-top: 16px; }

.dash-side { flex-grow: 1; min-width: 0; margin-left: 24px; }
.dash-recent__kind { flex-grow: 1; }
#root .dash-recent__value {
    width: 88px;
    font-size: var(--bq-fs-lg);
    -unity-text-align: middle-right;
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
#root .dash-recent__when { width: 64px; color: var(--bq-muted); -unity-text-align: middle-right; }
.dash-stat__pair { flex-direction: row; align-items: flex-end; }
#root .dash-stat__value {
    font-size: var(--bq-fs-xl);
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
#root .dash-stat__trend {
    margin-left: 12px;
    font-size: var(--bq-fs-md);
    color: var(--bq-muted);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
#root .dash-stat__trend--up   { color: var(--bq-hit); }
#root .dash-stat__trend--down { color: var(--bq-live-text); }

/* ── Window ───────────────────────────────────────────────────────────── */

.window {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}

/* Wood bar with a brass underside. */
.window-header {
    height: 88px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 48px;
    padding-right: 48px;
    background-color: var(--bq-wood);
    border-bottom-width: 3px;
    border-bottom-color: var(--bq-warm);
}

/* "Menu" in stone style: 9-slice tile sprite tinted like the cards. */
.window-header .window-back,
.window-header .window-back:hover {
    padding-left: 20px;
    padding-right: 20px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Art/UI/Button_Square03_White.png");
    -unity-background-image-tint-color: var(--bq-panel);
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-slice-scale: 0.5;
}
.window-header .window-back:hover { -unity-background-image-tint-color: var(--bq-tile-hover); }
#root .window-back { -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf"); }

#root .window-title {
    flex-grow: 1;
    margin-left: 24px;
    font-size: var(--bq-fs-2xl);
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}

#root .window-esc-hint {
    font-size: var(--bq-fs-sm);
    color: var(--bq-text);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--bq-warm);
    border-radius: var(--bq-radius);
}

/* Red rule under the header: the menu marker "thrown" into the window (UiFx.SweepRule). Hidden at rest. */
.window-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 3px;
    background-color: var(--bq-live);
    transform-origin: left;
    scale: 0 1;
    opacity: 0;
}

/* Menu ⇄ window swap (UiFx.OpenWindow / CloseWindow) — same 0s-enter trick as the content panels. */
.main-menu, .window {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--bq-dur-window-in);
    transition-timing-function: ease-out;
}
.main-menu--enter { opacity: 0; translate: -24px 0; transition-duration: 0s; }
.main-menu--exit  { opacity: 0; translate: -24px 0; transition-duration: var(--bq-dur-window-out); }
.window--enter    { opacity: 0; translate: 32px 0; transition-duration: 0s; }
.window--exit     { opacity: 0; transition-duration: var(--bq-dur-window-out); }

.window-rule--start { scale: 0.01 1; opacity: 1; }
.window-rule--sweep {
    scale: 1 1;
    opacity: 0;
    transition-property: scale, opacity;
    transition-duration: var(--bq-dur-marker), var(--bq-dur-rule-fade);
    transition-timing-function: ease-out;
}

/* ── Content panels + transitions ─────────────────────────────────────── */

.content-panel {
    flex-grow: 1;
    flex-direction: column;
    padding-top: 32px;
    padding-bottom: 32px;
    padding-left: 48px;
    padding-right: 48px;
    min-height: 0;
}

.sub-panel {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.content-panel, .sub-panel, .modal-overlay {
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: var(--bq-dur-enter);
    transition-timing-function: ease-out;
}

.content-panel--enter {
    opacity: 0;
    translate: 0 16px;
    transition-duration: 0s;
}

.content-panel--exit {
    opacity: 0;
    transition-duration: var(--bq-dur-exit);
}

.section-title {
    font-size: var(--bq-fs-sm);
    color: var(--bq-muted);
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf");
    margin-bottom: 8px;
}

.divider { height: 1px; background-color: var(--bq-line); margin-top: 12px; margin-bottom: 12px; flex-shrink: 0; }

/* ── Tabs (text + 2px live underline) ─────────────────────────────────── */

.tab-strip { flex-direction: row; margin-bottom: 16px; flex-shrink: 0; }

.stats-inner-tab {
    margin: 0;
    margin-right: 24px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--bq-muted);
    font-size: var(--bq-fs-md);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
    transition-property: color, border-bottom-color;
    transition-duration: 150ms;
}
.stats-inner-tab:hover   { color: var(--bq-text); }
.stats-inner-tab--active { color: var(--bq-text); border-bottom-color: var(--bq-live); }

/* ── Columns ──────────────────────────────────────────────────────────── */

.columns  { flex-direction: row; flex-grow: 1; min-height: 0; }
.col-side { width: 24%; flex-shrink: 0; flex-direction: column; min-height: 0; }
.col-side--left { margin-right: 20px; }
.col-main { flex-grow: 1; min-width: 0; flex-direction: column; margin-right: 20px; min-height: 0; }
.col-main--last { margin-right: 0; }
.col-main--wide { flex-grow: 2; }

/* ── Surfaces ─────────────────────────────────────────────────────────── */

/* Card: stone frame (9-slice, tinted panel) with a 2 px light top edge as bevel. */
.panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Art/UI/BasicFrame_Square01_White.Png");
    -unity-background-image-tint-color: var(--bq-panel);
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    -unity-slice-scale: 0.5;
    border-top-width: 2px;
    border-top-color: var(--bq-line);
    border-radius: 10px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: column;
    flex-shrink: 0;
}
.panel--grow { flex-grow: 1; min-height: 0; }
.panel--gap  { margin-bottom: 16px; }
.panel--center { align-items: center; justify-content: center; }

.empty-state { display: none; align-items: center; margin-top: 40px; }
.empty-state__title { font-size: var(--bq-fs-xl); color: var(--bq-text); margin-bottom: 8px; -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.empty-state__text  { font-size: var(--bq-fs-sm); color: var(--bq-muted); white-space: normal; -unity-text-align: upper-center; }

.list-block { flex-grow: 1; flex-direction: column; min-height: 0; padding-top: 12px; }
.list-header { flex-direction: row; align-items: center; margin-bottom: 6px; flex-shrink: 0; }
.list-title  { flex-grow: 1; font-size: var(--bq-fs-sm); color: var(--bq-muted); -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf"); }
.scroll { flex-grow: 1; min-height: 0; }
.scroll--fixed { height: 140px; flex-grow: 0; flex-shrink: 0; margin-top: 8px; }

/* ── Stats ────────────────────────────────────────────────────────────── */

.stat-grid  { flex-direction: row; justify-content: space-around; margin-bottom: 12px; flex-shrink: 0; }
.stat-block { align-items: center; }
.stat-caption { font-size: var(--bq-fs-xs); color: var(--bq-muted); -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf"); }
.stat-value {
    font-size: var(--bq-fs-2xl);
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}
.stat-value--small { font-size: var(--bq-fs-lg); }
.stat-value--big   { font-size: var(--bq-fs-4xl); -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf"); color: var(--bq-live-text); }

.hero-row  { flex-direction: row; margin-bottom: 16px; flex-shrink: 0; }
.hero      { flex-grow: 1; flex-direction: column; }
.hero-value {
    font-size: var(--bq-fs-3xl);
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}
.hero-value--positive { color: var(--bq-hit); }
.hero-value--negative { color: var(--bq-live-text); }
.hero-value--muted    { color: var(--bq-muted); }
.hero-caption { font-size: var(--bq-fs-xs); color: var(--bq-muted); -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf"); }

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--bq-line);
}
.stat-row__label { font-size: var(--bq-fs-sm); color: var(--bq-muted); }
.stat-row__value {
    font-size: var(--bq-fs-lg);
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}

.placeholder-text { color: var(--bq-muted); -unity-font-style: italic; font-size: var(--bq-fs-sm); }

/* ── Input strip ──────────────────────────────────────────────────────── */

.fields-row { flex-direction: row; align-items: flex-end; }

.dart-field {
    flex-grow: 1;
    flex-direction: column;
    margin: 0;
    margin-right: 12px;
    transition-property: opacity;
    transition-duration: 150ms;
}
.dart-field--last { margin-right: 0; }
.dart-field:disabled { opacity: 0.35; }

.dart-field .unity-base-field__label {
    min-width: 0;
    width: auto;
    padding: 0;
    margin: 0;
    margin-bottom: 4px;
    font-size: var(--bq-fs-xs);
    color: var(--bq-muted);
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf");
}

.dart-field .unity-base-field__input {
    height: 56px;
    background-color: var(--bq-stage);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    padding: 0;
    margin: 0;
    transition-property: border-color;
    transition-duration: 150ms;
}

.dart-field .unity-text-field__input,
.dart-field .unity-text-element--inner-input-field-component {
    color: var(--bq-text);
    font-size: var(--bq-fs-xl);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
    -unity-text-align: middle-center;
    --unity-cursor-color: var(--bq-live);
    --unity-selection-color: var(--bq-live-dim);
}

.dart-field:focus .unity-base-field__input,
.dart-field .unity-base-field__input:focus,
.dart-field .unity-text-element--inner-input-field-component:focus {
    border-color: var(--bq-live);
}

.feedback {
    margin-top: 8px;
    min-height: 18px;
    font-size: var(--bq-fs-sm);
    color: var(--bq-warm);
    white-space: normal;
}

.turn-label {
    font-size: var(--bq-fs-md);
    color: var(--bq-muted);
    margin-bottom: 8px;
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}

/* ── Buttons ──────────────────────────────────────────────────────────── */

.text-button {
    margin: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    color: var(--bq-text);
    font-size: var(--bq-fs-base);
    transition-property: background-color, border-color, color;
    transition-duration: 150ms;
}
.text-button:hover  { border-color: var(--bq-muted); background-color: var(--bq-hover); }
.text-button:active { background-color: rgba(255, 255, 255, 0.08); }
.text-button:disabled { opacity: 0.35; }

.text-button--small { padding-top: 4px; padding-bottom: 4px; padding-left: 10px; padding-right: 10px; font-size: var(--bq-fs-sm); }

.text-button--danger        { color: var(--bq-live-text); }
.text-button--danger:hover  { background-color: var(--bq-live); border-color: var(--bq-live); color: var(--bq-text); }

/* Primary: red stone button (Button01_Red, 9-slice); brightens on hover. */
.text-button--primary {
    padding-top: 10px;
    padding-bottom: 14px;
    padding-left: 28px;
    padding-right: 28px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/_Project/Art/UI/Button01_Red.png");
    -unity-background-image-tint-color: #E6E6E6;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 24;
    -unity-slice-bottom: 30;
    -unity-slice-scale: 0.5;
}
.text-button--primary:hover { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: #FFFFFF; }
#root .text-button--primary {
    color: var(--bq-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}

.button-row { flex-direction: row; justify-content: space-between; margin-top: 12px; flex-shrink: 0; }
.button-row .text-button { flex-grow: 1; }
.button-row__gap { margin-right: 12px; }

.icon-button {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--bq-muted);
    font-size: var(--bq-fs-xs);
    transition-property: color;
    transition-duration: 150ms;
}
.icon-button:hover { color: var(--bq-live-text); }

.field-grid { flex-direction: row; flex-wrap: wrap; overflow: hidden; }
.field-grid-button {
    width: 54px;
    height: 36px;
    margin: 0;
    margin-right: 4px;
    margin-bottom: 4px;
    padding: 0;
    background-color: var(--bq-stage);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    color: var(--bq-text);
    font-size: var(--bq-fs-sm);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
    transition-property: border-color, color;
    transition-duration: 150ms;
}
.field-grid-button:hover  { border-color: var(--bq-muted); }
.field-grid-button--active { border-color: var(--bq-live); color: var(--bq-live-text); }

/* ── Rows (code-built) ────────────────────────────────────────────────── */

.list-row {
    flex-direction: row;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--bq-line);
    background-color: rgba(0, 0, 0, 0);
}
.list-row--header { border-bottom-width: 0; padding-bottom: 2px; }
.list-row--header .unity-label { color: var(--bq-muted); font-size: var(--bq-fs-xs); -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf"); }

.list-row__num   { width: 40px; color: var(--bq-muted); font-size: var(--bq-fs-lg); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.list-row__darts { flex-grow: 1; font-size: var(--bq-fs-lg); color: var(--bq-text); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.list-row__score { width: 54px; -unity-text-align: middle-right; color: var(--bq-muted); font-size: var(--bq-fs-lg); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.list-row__rem   { width: 86px; -unity-text-align: middle-right; color: var(--bq-text); font-size: var(--bq-fs-lg); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.list-row__rem--bust     { color: var(--bq-live-text); }
.list-row__rem--checkout { color: var(--bq-hit); }

.list-row__cell { flex-grow: 1; font-size: var(--bq-fs-sm); -unity-text-align: middle-center; color: var(--bq-text); }
.list-row__cell--fixed { flex-grow: 0; -unity-text-align: middle-left; font-size: var(--bq-fs-xs); }
.list-row__cell--muted { color: var(--bq-muted); }
.list-row__cell--hit   { color: var(--bq-hit); }
.list-row__cell--live  { color: var(--bq-live-text); }

/* Stats history tables — fixed column widths (static headers + HistoryRow_* templates) */
.hist__del              { width: 36px; }
.hist-scoring__date     { width: 110px; }
.hist-scoring__avg      { width: 72px; }
.hist-scoring__180      { width: 48px; }
.hist-scoring__visits   { width: 66px; }
.hist-fo__date          { width: 110px; }
.hist-fo__3da           { width: 66px; }
.hist-fo__co            { width: 54px; }
.hist-fo__result        { width: 78px; }
.hist-co__date          { width: 110px; }
.hist-co__mode          { width: 78px; }
.hist-co__hit           { width: 54px; }
.hist-co__attempts      { width: 72px; }
.hist-tg__date          { width: 132px; }
.hist-tg__you           { width: 72px; }
.hist-tg__ai            { width: 72px; }
.hist-tg__co            { width: 60px; }
.hist-tg__result        { width: 66px; }

/* Finishes column */
.finish-header { font-size: var(--bq-fs-sm); color: var(--bq-muted); -unity-text-align: middle-center; margin-bottom: 6px; }
.finish-route  {
    font-size: var(--bq-fs-lg);
    color: var(--bq-muted);
    -unity-text-align: middle-center;
    margin-top: 2px;
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}
.finish-route--primary { font-size: var(--bq-fs-xl); color: var(--bq-hit); margin-top: 0; }

/* Five checkouts cards */
.five-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    background-color: rgba(0, 0, 0, 0);
}
.five-card--active { border-color: var(--bq-live); }
.five-card--done   { border-color: var(--bq-hit); }
.five-card__score  { font-size: var(--bq-fs-lg); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.five-card__status { font-size: var(--bq-fs-sm); color: var(--bq-muted); }
.five-card--active .five-card__status { color: var(--bq-live-text); }
.five-card--done   .five-card__status { color: var(--bq-hit); }

/* Bars */
.bar-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.bar-row__label { width: 48px; font-size: var(--bq-fs-xs); color: var(--bq-muted); }
.bar-row__track { flex-grow: 1; height: 6px; background-color: var(--bq-line); border-radius: var(--bq-radius); }
.bar-row__fill  { height: 100%; border-radius: var(--bq-radius); background-color: var(--bq-muted); }
.bar-row__fill--live  { background-color: var(--bq-live); }
.bar-row__fill--ai    { background-color: var(--bq-ai); }
.bar-row__fill--hit   { background-color: var(--bq-hit); }
.bar-row__fill--warm  { background-color: var(--bq-warm); }
.bar-row__fill--muted { background-color: var(--bq-muted); }
.bar-row__count { width: 86px; margin-left: 8px; font-size: var(--bq-fs-xs); color: var(--bq-muted); }

/* Training plan cards */
.plan-card {
    flex-direction: row;
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    margin-bottom: 12px;
    background-color: rgba(0, 0, 0, 0);
}
.plan-card__accent { width: 4px; background-color: var(--bq-muted); }
.plan-card--checkout    .plan-card__accent { background-color: var(--bq-warm); }
.plan-card--scoring     .plan-card__accent { background-color: var(--bq-hit); }
.plan-card--triple      .plan-card__accent { background-color: var(--bq-ai); }
.plan-card--consistency .plan-card__accent { background-color: var(--bq-live); }
.plan-card__content { flex-grow: 1; padding-top: 14px; padding-bottom: 14px; padding-left: 16px; padding-right: 16px; }
.plan-card__header  { flex-direction: row; align-items: center; margin-bottom: 6px; }
.plan-card__badge {
    font-size: var(--bq-fs-xs);
    color: var(--bq-muted);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 10px;
}
.plan-card__title  { font-size: var(--bq-fs-lg); color: var(--bq-text); -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf"); }
.plan-card__reason { font-size: var(--bq-fs-sm); color: var(--bq-muted); margin-bottom: 6px; white-space: normal; }
.plan-card__action { font-size: var(--bq-fs-sm); color: var(--bq-muted); }
.plan-card__button { align-self: center; margin-right: 16px; }

/* ── Score bug ────────────────────────────────────────────────────────── */

.score-bug { flex-direction: row; margin-bottom: 20px; flex-shrink: 0; }

.score-plate {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    background-color: var(--bq-panel);
    border-radius: var(--bq-radius);
    border-left-width: 4px;
    border-left-color: var(--bq-live);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 24px;
    transition-property: scale, background-color, border-left-color;
    transition-duration: var(--bq-dur-pop), var(--bq-dur-flash), var(--bq-dur-flash);
    transition-timing-function: ease-out;
}
.score-plate--ai { border-left-color: var(--bq-ai); margin-left: 20px; }

/* Bust: only the plate's 4px left edge blinks — background never flashes.
   .bq-fx--flash is the generic flash class from UiFx (Task 2); this
   plate-specific override keeps its name but redirects the flash from
   background-color to border-left-color. */
.score-plate.bq-fx--flash {
    background-color: var(--bq-panel);
    border-left-color: var(--bq-live-dim);
}

.score-plate__name {
    width: 96px;
    font-size: var(--bq-fs-md);
    letter-spacing: 2px;
    color: var(--bq-muted);
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
}
.score-plate__body { flex-grow: 1; flex-direction: column; align-items: flex-end; }
.score-plate__rest {
    font-size: var(--bq-fs-5xl);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
    color: var(--bq-live-text);
    -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf");
}
.score-plate--ai .score-plate__rest { color: var(--bq-ai); }
.score-plate__sub  { flex-direction: row; margin-top: -8px; }
.score-plate__meta { font-size: var(--bq-fs-sm); color: var(--bq-muted); margin-left: 16px; }

/* AI visit slots */
.ai-visit { align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.ai-slots { flex-direction: row; justify-content: center; margin-top: 4px; margin-bottom: 2px; }
.ai-slot {
    min-width: 64px;
    font-size: var(--bq-fs-xl);
    color: var(--bq-ai);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Project/Fonts/BarlowCondensed-Medium.ttf");
    transition-property: scale;
    transition-duration: var(--bq-dur-pop);
}
.ai-last { font-size: var(--bq-fs-sm); color: var(--bq-muted); -unity-text-align: middle-center; }

/* ── Charts + heatmap ─────────────────────────────────────────────────── */

.chart-container { height: 120px; flex-shrink: 0; margin-bottom: 12px; }
.chart-axis-label {
    position: absolute;
    width: 48px;
    font-size: var(--bq-fs-xs);
    color: var(--bq-muted);
    -unity-text-align: middle-right;
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf");
}
.chart-tooltip {
    position: absolute;
    display: none;
    background-color: var(--bq-panel);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    color: var(--bq-text);
    font-size: var(--bq-fs-xs);
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
}

.heatmap-slot { height: 240px; flex-shrink: 0; }
.heatmap-number {
    position: absolute;
    width: 28px;
    height: 20px;
    font-size: var(--bq-fs-xs);
    color: var(--bq-muted);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf");
}
.heatmap-legend-label {
    position: absolute;
    bottom: 0;
    font-size: var(--bq-fs-xs);
    color: var(--bq-muted);
    -unity-font-definition: url("/Assets/_Project/Fonts/Barlow-Regular.ttf");
}

/* ── Generic fx classes (UiFx) ────────────────────────────────────────── */

.bq-fx {
    transition-property: scale, translate, background-color;
    transition-duration: var(--bq-dur-pop), var(--bq-dur-shake), var(--bq-dur-flash);
    transition-timing-function: ease-out;
}
.bq-fx--pop     { scale: 1.06 1.06; }
.bq-fx--shake-l { translate: -6px 0; }
.bq-fx--shake-r { translate: 6px 0; }
.bq-fx--flash   { background-color: var(--bq-live-dim); transition-duration: 0s; }

/* Plate keeps its edge transition while bq-fx is attached (bust edge blink). */
.score-plate.bq-fx {
    transition-property: scale, translate, background-color, border-left-color;
    transition-duration: var(--bq-dur-pop), var(--bq-dur-shake), var(--bq-dur-flash), var(--bq-dur-flash);
}

/* Flash entry stays instant on the plate; exit eases via .score-plate's own transition once both classes drop. */
.score-plate.bq-fx--flash { transition-duration: 0s; }

/* ── Root overlays ────────────────────────────────────────────────────── */

.modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}
.modal-box {
    background-color: var(--bq-panel);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    padding-top: 28px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
    min-width: 340px;
    max-width: 460px;
    flex-direction: column;
    align-items: center;
    scale: 1 1;
    transition-property: scale;
    transition-duration: var(--bq-dur-card);
    transition-timing-function: ease-out;
}
.content-panel--enter .modal-box { scale: 0.96 0.96; }
.modal-message { font-size: var(--bq-fs-base); color: var(--bq-text); -unity-text-align: upper-center; margin-bottom: 20px; white-space: normal; }
.modal-buttons { flex-direction: row; justify-content: flex-end; width: 100%; }
.modal-buttons .text-button { margin-left: 12px; }

.game-over-title { font-size: var(--bq-fs-2xl); color: var(--bq-text); -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf"); margin-bottom: 4px; }
.game-over-sub   { font-size: var(--bq-fs-base); color: var(--bq-muted); margin-bottom: 24px; }

.lower-third {
    position: absolute;
    left: 0;
    bottom: 72px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bq-panel);
    border-left-width: 4px;
    border-left-color: var(--bq-live);
    border-top-right-radius: var(--bq-radius);
    border-bottom-right-radius: var(--bq-radius);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 28px;
    padding-right: 40px;
    translate: -110% 0;
    transition-property: translate;
    transition-duration: var(--bq-dur-banner);
    transition-timing-function: ease-out;
}
.lower-third--in { translate: 0 0; }
.lower-third__label { font-size: var(--bq-fs-3xl); color: var(--bq-text); -unity-font-definition: url("/Assets/_Project/Fonts/LilitaOne-Regular.ttf"); }

/* ── Settings ─────────────────────────────────────────────────────────── */

.settings-body { flex-direction: column; max-width: 560px; }
.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--bq-line);
}
.settings-row__label { font-size: var(--bq-fs-base); color: var(--bq-text); }
.settings-row__hint  { font-size: var(--bq-fs-xs); color: var(--bq-muted); margin-top: 2px; }

.motion-toggle { margin: 0; }
.motion-toggle .unity-toggle__input { justify-content: flex-end; }
.motion-toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    margin: 0;
    background-color: var(--bq-stage);
    border-width: 1px;
    border-color: var(--bq-line);
    border-radius: var(--bq-radius);
    -unity-background-image-tint-color: var(--bq-text);
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}
.motion-toggle:checked .unity-toggle__checkmark { background-color: var(--bq-live); border-color: var(--bq-live); }

/* ── Reduced motion: every transition-bearing selector → 0 s ─────────── */

.bq-no-motion .menu-tile,
.bq-no-motion .menu-tile__frame,
.bq-no-motion .dash-board,
.bq-no-motion .dash-board--enter,
.bq-no-motion .main-menu,
.bq-no-motion .window,
.bq-no-motion .main-menu--exit,
.bq-no-motion .window--exit,
.bq-no-motion .nav-marker,
.bq-no-motion .content-panel,
.bq-no-motion .sub-panel,
.bq-no-motion .modal-overlay,
.bq-no-motion .content-panel--enter,
.bq-no-motion .content-panel--exit,
.bq-no-motion .stats-inner-tab,
.bq-no-motion .dart-field,
.bq-no-motion .dart-field .unity-base-field__input,
.bq-no-motion .text-button,
.bq-no-motion .icon-button,
.bq-no-motion .field-grid-button,
.bq-no-motion .score-plate,
.bq-no-motion .ai-slot,
.bq-no-motion .bq-fx,
.bq-no-motion .modal-box,
.bq-no-motion .lower-third,
.bq-no-motion .motion-toggle .unity-toggle__checkmark {
    transition-duration: 0s;
}

/* Reduced motion: no lift, no press offset — the tint change alone marks hover/focus. */
.bq-no-motion .menu-tile:hover,
.bq-no-motion .menu-tile:focus,
.bq-no-motion .menu-tile:active .menu-tile__frame { translate: 0 0; }
